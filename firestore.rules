rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helperfuncties (v1) ---

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/gebruikers/$(request.auth.uid)).data;
    }

    function meExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/gebruikers/$(request.auth.uid));
    }

    function actief() {
      return meExists() && me().status == 'actief';
    }

    function isSuper() {
      return actief() && me().rol == 'superbeheerder';
    }

    function isSchoolAdmin(schoolId) {
      return actief()
        && me().rol == 'schoolbeheerder'
        && me().schoolId == schoolId;
    }

    function isTeacherOf(schoolId, klasId) {
      return actief()
        && me().rol == 'leerkracht'
        && me().schoolId == schoolId
        && klasId in me().klasIds;
    }

    // --- Gebruikers ---
    // - Iedereen leest zijn eigen document (nodig om status/rol te controleren bij login)
    // - Schoolbeheerder leest en beheert gebruikers van zijn school, maar kan nooit rol "superbeheerder" geven
    // - Niemand kan zijn eigen rol, schoolId of status wijzigen
    // - Superbeheerder kan alles
    match /gebruikers/{uid} {
      allow read: if isSuper()
        || (signedIn() && request.auth.uid == uid)
        || isSchoolAdmin(resource.data.schoolId);

      allow create: if isSuper()
        || (isSchoolAdmin(request.resource.data.schoolId)
            && request.resource.data.rol in ['schoolbeheerder', 'leerkracht']);

      allow update: if isSuper()
        || (isSchoolAdmin(resource.data.schoolId)
            && request.auth.uid != uid
            && resource.data.rol != 'superbeheerder'
            && request.resource.data.schoolId == resource.data.schoolId
            && request.resource.data.rol in ['schoolbeheerder', 'leerkracht'])
        || (actief()
            && request.auth.uid == uid
            && request.resource.data.rol == resource.data.rol
            && request.resource.data.schoolId == resource.data.schoolId
            && request.resource.data.status == resource.data.status
            && request.resource.data.klasIds == resource.data.klasIds);

      allow delete: if isSuper()
        || (isSchoolAdmin(resource.data.schoolId)
            && request.auth.uid != uid
            && resource.data.rol != 'superbeheerder');
    }

    // --- Scholen & subcollecties ---
    // Standaard geweigerd in v1; voeg per collectie regels toe in de volgende fasen.
    // Alles is strikt gescheiden per schoolId.
    match /scholen/{schoolId} {
      allow read, write: if false;

      match /{document=**} {
        allow read, write: if false;
      }
    }

    // --- Overige paden standaard weigeren ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
